# Local dev only — on Heroku these are set as config vars, not read from this file.

# Postgres connection. On Heroku this is set automatically by the Postgres add-on.
DATABASE_URL=postgresql://localhost/events360_dev

# Used to sign JWT access tokens. Generate a real random value for production,
# e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production

# Used only when running: python -m app.seeds.seed_superadmin
SUPERADMIN_NAME=Tito
SUPERADMIN_EMAIL=tito@eventsnxt.com
SUPERADMIN_PASSWORD=change-me-see-real-value-in-password-manager-not-here